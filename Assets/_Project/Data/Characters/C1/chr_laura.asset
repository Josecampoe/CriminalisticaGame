  _fallback:
    _crime:
      _text: "Elena no ten\xEDa enemigos... bueno, solo los que le tra\xEDa su trabajo."
      _revealsFactIds: []
    _otherPerson:
      _text: "Carlos vino esa noche, los o\xED gritar. \xC9l fumaba en el balc\xF3n, siempre."
      _revealsFactIds:
      - f_c1_laura_gritos
      - f_c1_laura_fumar
    _evidence:
      _text: "\xBFMi tel\xE9fono? Ah... se me debi\xF3 caer."
      _revealsFactIds: []
    _press:
      _text: "Est\xE1 bien, llegu\xE9 antes. O\xED un golpe, esper\xE9... ten\xEDa miedo. Cuando entr\xE9 ya estaba en el piso."
