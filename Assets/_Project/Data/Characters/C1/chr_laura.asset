  _id: laura
  _displayName: "Laura R\xEDos"
  _age: 29
  _role: Enfermera, vecina del 403 y amiga de Elena
  _caseId: c1
  _personality: "C\xE1lida, protectora y nerviosa. Habla r\xE1pido cuando miente."
  _portrait: {fileID: 0}
  _placeholderColor: {r: 0.3, g: 0.45, b: 0.6, a: 1}
  _knownFacts:
  - _id: f_c1_laura_gritos
    _text: "Oy\xF3 gritos hacia las 9:30."
  - _id: f_c1_laura_golpe
    _text: "Oy\xF3 un golpe hacia las 10:35."
  - _id: f_c1_laura_encontro
    _text: "Encontr\xF3 a Elena a las 10:48 con la puerta abierta."
  - _id: f_c1_laura_fumar
    _text: "Sabe que Carlos siempre fumaba en el balc\xF3n."
  - _id: f_c1_laura_cuaderno
    _text: "Elena le pidi\xF3 guardar su cuaderno si algo le pasaba. Laura lo tiene."
