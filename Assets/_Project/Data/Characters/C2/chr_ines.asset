  _id: ines
  _displayName: "In\xE9s Caicedo"
  _age: 38
  _role: Guardia de seguridad nocturna de la Torre Nexo
  _caseId: c2
  _personality: Madre soltera, seria y trabajadora, con mucho miedo a perder su empleo. Se quiebra cuando la tratan con respeto.
  _portrait: {fileID: 0}
  _placeholderColor: {r: 0.2, g: 0.25, b: 0.4, a: 1}
  _knownFacts:
  - _id: f_c2_ines_llamada
    _text: "Valeria la llam\xF3 a las 11:20 y le pidi\xF3 apagar la c\xE1mara."
  - _id: f_c2_ines_vio
    _text: Vio entrar a Valeria a las 11:30.
  - _id: f_c2_ines_sobre
    _text: "Recibi\xF3 un sobre con dinero."
  - _id: f_c2_ines_backup
    _text: El servidor de la caseta guarda copias espejo de los registros.
  _lies:
  - {fileID: 11400000, guid: 877fc61b9a24f2549abe3a564da1acb7, type: 2}
  _secrets: []
  _fallback:
    _crime:
      _text: "Yo lo encontr\xE9. Todav\xEDa no puedo dormir."
      _revealsFactIds: []
    _otherPerson:
      _text: "El muchacho, Sebasti\xE1n, sali\xF3 temprano en la moto."
      _revealsFactIds: []
    _evidence:
      _text: "Ese sobre no es m\xEDo... bueno, s\xED, pero no es lo que parece."
      _revealsFactIds: []
    _press:
      _text: "\xA1Ella me pidi\xF3 apagar la c\xE1mara! La se\xF1ora Duarte. Me dijo que era mantenimiento. Yo no sab\xEDa nada, se lo juro."
